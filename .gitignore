# ─── Dependencies ─────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*

# ─── Build outputs ────────────────────────────────────
.next/
/out/
/build
.turbo
dist/

# ─── Environment & Secrets (never commit) ────────────
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
packages/*/.env
packages/*/.env.*
!packages/*/.env.example
*.local

# ─── IDE / Editor ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS files ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Debug logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── TypeScript ──────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing ─────────────────────────────────────────
/coverage

# ─── Database (SQLite) ───────────────────────────────
prisma/dev.db
prisma/dev.db-journal
packages/database/prisma/dev.db
packages/database/prisma/dev.db-journal
*.db
*.db-journal

# ─── Uploads ─────────────────────────────────────────
public/uploads/*
!public/uploads/.gitkeep
apps/*/public/uploads/*
!apps/*/public/uploads/.gitkeep

# ─── Tools ───────────────────────────────────────────
.claude/
.mcp.json

# ─── Vercel ──────────────────────────────────────────
.vercel

# ─── Misc temp ───────────────────────────────────────
*.tmp
*.bak
*.pid
