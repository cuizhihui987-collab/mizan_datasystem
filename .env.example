# Database
# SQLite: file:./packages/database/prisma/dev.db
# PostgreSQL: postgresql://user:password@host:5432/db
DATABASE_URL="file:./packages/database/prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret"

# Upload storage (local or s3)
UPLOAD_DIR="./public/uploads"
STORAGE_TYPE="local"

# S3 (only if STORAGE_TYPE=s3)
# S3_BUCKET="mizan-files"
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"

# Import concurrency
IMPORT_MAX_CONCURRENCY=2
